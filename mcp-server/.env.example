# Supabase — server-side access.
# Use the SERVICE-ROLE key (not the publishable/anon key). It bypasses RLS,
# so the server can aggregate across rows. Keep it secret — never commit .env.
SUPABASE_URL=https://efluojvfzcmldhtwnwic.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Admin — the only auth.users id allowed to write to exercise_library
# (add_library_exercise). Find it in Supabase: Authentication > Users.
ADMIN_USER_ID=your-auth-user-uuid-here

# LLM provider — 'anthropic' (default) or 'bedrock' (stubbed until Phase 7).
LLM_PROVIDER=anthropic

# Anthropic API — required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: model used by the Anthropic provider.
ANTHROPIC_MODEL=claude-sonnet-4-6
